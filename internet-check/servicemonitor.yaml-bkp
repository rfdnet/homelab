apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: speedtest-exporter-monitor
  namespace: monitoring
spec:
  selector:
    matchLabels:
      app: speedtest-exporter
  namespaceSelector:
    matchNames:
      - internet-check-home
  endpoints:
  - port: metrics
    interval: 60s
    scrapeTimeout: 30s
